    {
      "name": "submit_homework",
      "title": "提交作业附件",
      "description": "向指定作业上传并提交本地文件及纯文本备注，可能覆盖已有附件与正文。检查截止时间、格式和本地目录，随后核验状态、附件名和正文。filePath 与 filePaths 二选一；多文件按配置打包为一个 ZIP，课程必须接受 ZIP。不确定结果不会自动重发。仅在用户明确要求提交指定文件时调用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "homeworkId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "使用列表返回的 ID，不要使用作业标题。"
          },
          "filePath": {
            "description": "服务所在电脑上的一个文件绝对路径。",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "filePaths": {
            "description": "服务所在电脑上的多个文件绝对路径，将打包 ZIP。",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "remarks": {
            "default": "",
            "description": "作业备注，按纯文本转义后作为 zynr 提交。",
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "homeworkId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
