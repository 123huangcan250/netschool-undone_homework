{
  "name": "thu-learn-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cookie-only Tsinghua Web Learning MCP server",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "probe": "tsx scripts/probe.ts",
    "test:live": "tsx scripts/live-test.ts",
    "export-tools": "tsx scripts/export-tools.ts",
    "package": "tsx scripts/package.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "luxon": "3.7.2",
    "tough-cookie": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
